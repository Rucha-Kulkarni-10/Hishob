# HISHOB Frontend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to Git.
#
# IMPORTANT:
#   VITE_* variables are embedded into the browser bundle at build time.
#   Never put secrets, JWT signing keys, database passwords, or internal
#   service tokens into VITE_ variables — they are visible to every user.

# URL of the HISHOB API Gateway.
# All frontend requests go through the Gateway, never directly to services.
VITE_API_BASE_URL=http://localhost:8080
