# ========================================
# HISHOB Auth Service — Local Development Configuration Example
# ========================================
# 
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace placeholder values with your actual configuration
# 3. Never commit the .env file (it's already in .gitignore)
#
# ========================================

# ── Database Configuration ──
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# ── Mailgun Email Configuration ──
# Enable Mailgun email delivery (false = emails are not sent)
MAILGUN_ENABLED=false

# Mailgun API Key (KEEP SECRET — get from Mailgun dashboard)
MAILGUN_API_KEY=your-mailgun-api-key-here

# Mailgun sandbox domain (get from Mailgun dashboard)
MAILGUN_DOMAIN=sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org

# Mailgun API base URL (default: https://api.mailgun.net)
MAILGUN_BASE_URL=https://api.mailgun.net

# Email sender display name and address
MAILGUN_FROM_NAME=HISHOB
MAILGUN_FROM_EMAIL=noreply@hishob.com

# ── Email Verification ──
# Enforce email verification before user can log in (false = verification optional)
EMAIL_VERIFICATION_REQUIRED=false

# ── Manual Test Guards ──
# Manual test safety flag (MUST be explicitly enabled to send test emails)
MAILGUN_MANUAL_TEST_ENABLED=false

# Authorized recipient for manual sandbox tests
# IMPORTANT: Must be authorized in your Mailgun sandbox settings
MAILGUN_TEST_RECIPIENT=your-authorized-email@example.com
