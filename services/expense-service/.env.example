# ========================================
# HISHOB Expense Service — Local Development Configuration Example
# ========================================
#
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace placeholder values with your actual configuration
# 3. Never commit the .env file (it's already in .gitignore)
#
# Required by start-hishob.ps1 — startup aborts if .env is missing.
# ========================================

# ── Database Configuration ──
DB_HOST=localhost
DB_PORT=5432
# Database name this service connects to
DB_NAME=hishob_expense
# JDBC search_path schema. The real local cluster keeps all tables in "public";
# the committed yml fallback (hishob_expense) names a schema that does not exist.
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
