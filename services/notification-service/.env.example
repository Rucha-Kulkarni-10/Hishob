# ========================================
# HISHOB Notification Service — Local Development Configuration Example
# ========================================
#
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace placeholder values with your actual configuration
# 3. Never commit the .env file (it's already in .gitignore)
#
# Required by start-hishob.ps1 — startup aborts if .env is missing.
# ========================================

# ── Database Configuration ──
# NOTE: this service's yml has no currentSchema parameter — its tables
# resolve to the default "public" schema, so no DB_SCHEMA is needed.
DB_HOST=localhost
DB_PORT=5432
# Database name this service connects to
DB_NAME=hishob_notification
DB_USERNAME=postgres
DB_PASSWORD=your-password-here
