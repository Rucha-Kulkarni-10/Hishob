# ========================================
# HISHOB Settlement Service — Local Development Configuration Example
# ========================================
#
# Instructions:
# 1. Copy this file to .env in the same directory
# 2. Replace placeholder values with your actual configuration
# 3. Never commit the .env file (it's already in .gitignore)
#
# Required by start-hishob.ps1 — startup aborts if .env is missing.
# ========================================

# ── Database Configuration ──
DB_HOST=localhost
DB_PORT=5432
# Database name this service connects to
DB_NAME=hishob_settlement
# JDBC search_path schema. The real local cluster keeps all tables in "public";
# the committed yml fallback (hishob_settlement) names a schema that does not exist.
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=your-password-here

# ── Service Authentication Secrets ──

# REQUIRED. The service yml has no fallback value, so startup fails fast if either

# variable is missing, blank or still set to this placeholder text.

# JWT_SECRET must be IDENTICAL across auth, expense and settlement service: auth signs the

# tokens and the other two verify them with the same HMAC key.

# Generate one unique value per environment (32+ characters, e.g. openssl rand -base64 48).

# Never copy a real credential into this example file and never commit the .env file.

JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

INTERNAL_SERVICE_TOKEN=replace-with-a-unique-internal-token-of-at-least-32-characters
